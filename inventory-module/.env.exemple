# ══════════════════════════════════════════════════════════════════════════════
# Environment Variables Template
# ══════════════════════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════════════════════
# LLM PROVIDER CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════
# Choose your LLM provider by uncommenting ONE of the sections below.
# The system will use whichever provider is specified in LLM_PROVIDER.

# ── OPTION 1: Ollama (Local) ──────────────────────────────────────────────────
# Free, runs locally, no API key needed
# Install: https://ollama.ai
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# ── OPTION 2: Groq (Cloud) ────────────────────────────────────────────────────
# Fast, free tier available, requires API key
# Get API key: https://console.groq.com
#LLM_PROVIDER=groq
#GROQ_API_KEY=gsk_your_api_key_here
#GROQ_MODEL=llama-3.3-70b-versatile

# ── OPTION 3: OpenAI (Cloud) ──────────────────────────────────────────────────
# Industry standard, paid, requires API key
# Get API key: https://platform.openai.com
#LLM_PROVIDER=openai
#OPENAI_API_KEY=sk-your_api_key_here
#OPENAI_MODEL=gpt-4o-mini
#OPENAI_BASE_URL=https://api.openai.com/v1

# ── OPTION 4: Anthropic (Cloud) ───────────────────────────────────────────────
# Claude models, paid, requires API key
# Get API key: https://console.anthropic.com
#LLM_PROVIDER=anthropic
#ANTHROPIC_API_KEY=sk-ant-your_api_key_here
#ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── LLM Settings (applies to all providers) ───────────────────────────────────
LLM_TEMPERATURE=0.0  # 0.0 = deterministic, 1.0 = creative


# ══════════════════════════════════════════════════════════════════════════════
# APPLICATION SETTINGS
# ══════════════════════════════════════════════════════════════════════════════

# Environment (development, staging, production)
ENVIRONMENT=development

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO


# ══════════════════════════════════════════════════════════════════════════════
# MCP CONFIGURATION (Optional)
# ══════════════════════════════════════════════════════════════════════════════
#MCP_SERVER_URL=


# ══════════════════════════════════════════════════════════════════════════════
# DATABASE (Future Use)
# ══════════════════════════════════════════════════════════════════════════════
#DATABASE_URL=postgresql://user:password@localhost:5432/inventory_db


# ══════════════════════════════════════════════════════════════════════════════
# QUICK SWITCHING GUIDE
# ══════════════════════════════════════════════════════════════════════════════
# To switch providers:
#   1. Comment out the current LLM_PROVIDER and its settings
#   2. Uncomment your desired provider's LLM_PROVIDER and settings
#   3. Restart your application
#
# Example - Switch from Ollama to Groq:
#   Before:
#     LLM_PROVIDER=ollama
#     #LLM_PROVIDER=groq
#     #GROQ_API_KEY=gsk_...
#
#   After:
#     #LLM_PROVIDER=ollama
#     LLM_PROVIDER=groq
#     GROQ_API_KEY=gsk_...
# ══════════════════════════════════════════════════════════════════════════════
