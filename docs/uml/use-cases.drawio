        <mxCell id="sys" value="Système Retail multi-agents — Coaching commercial &amp; Optimisation des stocks" style="rounded=0;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=#f9f9f9;strokeColor=#666666;container=1;collapsible=0;" vertex="1" parent="1">
