' ============================================================
' Diagrammes de cas d'utilisation — Système multi-agents
' Coaching commercial & optimisation des stocks
' Rendu : plantuml.com/plantuml ou extension PlantUML VS Code
' ============================================================

' ---------- Diagramme global ----------
@startuml use_cases_global
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FDF6F6
  BorderColor #C0141C
}

actor "Conseiller de vente" as Conseiller
actor "Gestionnaire de stock" as Gestionnaire
actor "Manager point de vente" as Manager
actor "Système (planificateur\n/ bus d'alertes)" as Systeme <<system>>

rectangle "Système multi-agents Sales & Inventory" {

  package "Authentification & accès" {
    usecase "S'authentifier" as UC_AUTH
    usecase "Contrôler les accès\npar rôle et point de vente" as UC_RBAC
  }

  package "Coaching commercial" {
    usecase "Dialoguer avec\nl'assistant coach" as UC_CHAT
    usecase "Consulter les produits\nrecommandés scorés" as UC_SCORED
    usecase "Consulter les scripts\net arguments de vente" as UC_SCRIPTS
  }

  package "Analyse des ventes" {
    usecase "Consulter le dashboard\nventes et KPIs" as UC_KPI
    usecase "Consulter les\nprévisions de ventes" as UC_FCST_S
    usecase "Consulter les anomalies\net tendances détectées" as UC_ANOM
  }

  package "Gestion des stocks" {
    usecase "Consulter l'état\ndes stocks" as UC_STOCK
    usecase "Identifier les produits\nà risque" as UC_RISK
    usecase "Consulter le contexte\nde demande" as UC_CTX
    usecase "Consulter les prévisions\nde demande" as UC_FCST_I
  }

  package "Réapprovisionnement & commandes" {
    usecase "Lancer une analyse\nde réapprovisionnement" as UC_ANALYSE
    usecase "Consulter les recommandations\net leurs explications" as UC_RECO
    usecase "Valider / modifier / refuser\nune recommandation (HITL)" as UC_HITL
    usecase "Suivre le cycle des commandes\nsur le Kanban" as UC_KANBAN
    usecase "Réceptionner une commande" as UC_RECEP
  }

  package "Supervision & temps réel" {
    usecase "Recevoir les alertes\nen temps réel" as UC_ALERT
    usecase "Consulter le monitoring\ndu guardrail" as UC_MON
  }
}

' --- relations acteurs ---
Conseiller --> UC_AUTH
Conseiller --> UC_CHAT
Conseiller --> UC_SCORED
Conseiller --> UC_SCRIPTS
Conseiller --> UC_KPI
Conseiller --> UC_ALERT

Gestionnaire --> UC_AUTH
Gestionnaire --> UC_STOCK
Gestionnaire --> UC_RISK
Gestionnaire --> UC_CTX
Gestionnaire --> UC_FCST_I
Gestionnaire --> UC_ANALYSE
Gestionnaire --> UC_RECO
Gestionnaire --> UC_HITL
Gestionnaire --> UC_KANBAN
Gestionnaire --> UC_RECEP
Gestionnaire --> UC_ALERT

Manager --> UC_AUTH
Manager --> UC_KPI
Manager --> UC_FCST_S
Manager --> UC_ANOM
Manager --> UC_MON

Systeme --> UC_ANALYSE : déclenchement\nautomatique (alerte)
Systeme --> UC_ALERT : diffusion WebSocket

' --- relations include / extend ---
UC_CHAT ..> UC_AUTH : <<include>>
UC_STOCK ..> UC_AUTH : <<include>>
UC_AUTH ..> UC_RBAC : <<include>>
UC_CHAT ..> UC_SCRIPTS : <<include>>
UC_CHAT ..> UC_SCORED : <<include>>
UC_RECO ..> UC_HITL : <<extend>>
UC_HITL ..> UC_KANBAN : <<include>>
UC_KANBAN ..> UC_RECEP : <<extend>>
UC_ANALYSE ..> UC_RECO : <<include>>
@enduml

' ---------- Cas d'utilisation : coaching conversationnel (détail) ----------
@startuml use_cases_coaching
left to right direction
skinparam usecase {
  BackgroundColor #F2F7FC
  BorderColor #1D5FA8
}

actor "Conseiller de vente" as C

rectangle "Coaching commercial temps réel" {
  usecase "Poser une question\nen langage naturel" as UC1
  usecase "Recevoir la réponse\nen streaming (SSE)" as UC2
  usecase "Rechercher des scripts\nde vente (RAG)" as UC3
  usecase "Analyser les ventes\n(KPIs, tendances, prévisions)" as UC4
  usecase "Consulter le contexte marché\n(événements, offres)" as UC5
  usecase "Consulter l'état du stock\n(alertes rupture)" as UC6
  usecase "Contrôler la réponse\n(Guardrail)" as UC7
  usecase "Soumettre à validation\nhumaine (HITL)" as UC8
  usecase "Fournir une réponse\nde repli sûre" as UC9
}

C --> UC1
UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>
UC1 ..> UC5 : <<include>>
UC1 ..> UC6 : <<include>>
UC1 ..> UC7 : <<include>>
UC7 ..> UC8 : <<extend>>\nréponse sensible
UC7 ..> UC9 : <<extend>>\nréponse bloquée
UC1 ..> UC2 : <<include>>
@enduml

' ---------- Cas d'utilisation : réapprovisionnement (détail) ----------
@startuml use_cases_reappro
left to right direction
skinparam usecase {
  BackgroundColor #FCF7EF
  BorderColor #B06400
}

actor "Gestionnaire de stock" as G
actor "Bus d'alertes" as Bus <<system>>

rectangle "Assistance au réapprovisionnement" {
  usecase "Déclencher un cycle\nd'analyse" as UC1
  usecase "Diagnostiquer l'état du stock\n(couverture, rotation, risques)" as UC2
  usecase "Enrichir avec le contexte\n(prévisions, événements, promos)" as UC3
  usecase "Générer une recommandation\n(action + quantité + explication)" as UC4
  usecase "Valider / modifier / refuser\nla recommandation" as UC5
  usecase "Créer la suggestion de commande\nsur le Kanban" as UC6
  usecase "Suivre et faire évoluer\nla commande jusqu'à réception" as UC7
  usecase "Mettre à jour le stock\nà la réception" as UC8
  usecase "Enregistrer le feedback\nhumain" as UC9
}

G --> UC1
Bus --> UC1 : alerte stock\ntemps réel
UC1 ..> UC2 : <<include>>
UC2 ..> UC3 : <<include>>
UC3 ..> UC4 : <<include>>
G --> UC5
UC5 ..> UC6 : <<extend>>\nsi approuvée
UC5 ..> UC9 : <<include>>
G --> UC7
UC7 ..> UC8 : <<extend>>\ntransition REÇU
@enduml
