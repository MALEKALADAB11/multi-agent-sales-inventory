<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0">
  <diagram id="ooredoo-multiagent" name="Multi-Agents">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== TITLE ===================== -->
        <mxCell id="title" value="Architecture MULTI-AGENTS — SupervisorAgent (LangGraph fan-out / fan-in)" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="560" y="20" width="1280" height="40" as="geometry" />
        </mxCell>

        <!-- ===================== TRIGGERS ===================== -->
        <mxCell id="trig-box" value="DÉCLENCHEURS (qui lance le multi-agents)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="90" width="360" height="230" as="geometry" />
        </mxCell>
        <mxCell id="trig-cron" value="CronTrigger — 15 min&#10;top-N boutiques&#10;→ cycle complet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="130" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="trig-sale" value="SaleEventTrigger — 2 étages (debounce ~20s)&#10;Ét.1 Analyste seul (déterministe)&#10;Ét.2 cycle complet si urgence↑ / gap ±5pts / faisabilité↓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="190" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="trig-alert" value="AlertCycleTrigger — Redis alerts:store:*:stock&#10;rupture → cycle immédiat (URGENT/HIGH, debounce 180s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="260" width="320" height="50" as="geometry" />
        </mxCell>

        <!-- ===================== SUPERVISOR GRAPH ===================== -->
        <mxCell id="sup-box" value="SupervisorAgent — méta-graphe LangGraph (supervisor_agent.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="520" y="90" width="1320" height="1180" as="geometry" />
        </mxCell>

        <mxCell id="sup-init" value="initialize_state&#10;(génère cycle_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1070" y="130" width="220" height="45" as="geometry" />
        </mxCell>
        <mxCell id="fanout-lbl" value="FAN-OUT — 4 branches en parallèle (chacune écrit sa whitelist de champs dans RetailState)" style="text;html=1;fontSize=12;fontStyle=2;align=center;fillColor=none;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="560" y="185" width="1240" height="20" as="geometry" />
        </mxCell>

        <!-- ===== BRANCH 1: SALES (Analyste -> Stratege) ===== -->
        <mxCell id="br-sales" value="sales_branch  (CycleOrchestrator — SÉQUENTIEL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="545" y="215" width="360" height="320" as="geometry" />
        </mxCell>
        <mxCell id="ag-analyst" value="① ANALYSTE (déterministe · 0 LLM · &lt;1s)&#10;receive_pos → validate → load_memory&#10;→ ts_analyst → compare_memory&#10;→ build_strategy_query → save&#10;&#10;ts_engine : Holt-Winters + EOD hybride&#10;+ gap horaire + urgence + faisabilité" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="560" y="250" width="330" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ag-stratege" value="② STRATÈGE (LLM · pattern Reflexion)&#10;fetch_context → rag_search → analyze_context&#10;→ generate_strategy → build_output&#10;→ self_critique (score sa propre stratégie)&#10;&#10;→ strategie_actions, cause_racine, focus_produits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="560" y="400" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e-seq" style="endArrow=classic;html=1;strokeColor=#d6b656;strokeWidth=2;" edge="1" parent="1" source="ag-analyst" target="ag-stratege">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="e-seql" value="rag_query (dépendance de données)" style="edgeLabel;html=1;fontSize=9;" connectable="0" vertex="1" parent="e-seq"><mxGeometry x="-0.1" relative="1" as="geometry" /></mxCell>
        </mxCell>

        <!-- ===== BRANCH 2: KNOWLEDGE ===== -->
        <mxCell id="br-know" value="knowledge_branch&#10;RAG Milvus (node_rag_search)&#10;→ retrieved_scripts, rag_context&#10;scripts de vente similaires [S*]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="930" y="215" width="300" height="110" as="geometry" />
        </mxCell>

        <!-- ===== BRANCH 3: CONTEXT ===== -->
        <mxCell id="br-ctx" value="context_branch&#10;fetch_full_context&#10;→ external_context&#10;météo (Open-Meteo) · fériés · events/festivals · promos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1250" y="215" width="300" height="110" as="geometry" />
        </mxCell>

        <!-- ===== BRANCH 4: INVENTORY (chain of 3) ===== -->
        <mxCell id="br-inv" value="inventory_branch  (InventoryOrchestrator — batch 8 workers)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1570" y="215" width="250" height="320" as="geometry" />
        </mxCell>
        <mxCell id="ag-analysis" value="⑤ ANALYSIS&#10;fetch→compute→reason&#10;EOQ, reorder point, safety&#10;stock, risque (LLM=évaluateur)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1585" y="250" width="220" height="75" as="geometry" />
        </mxCell>
        <mxCell id="ag-context" value="⑥ CONTEXT&#10;fetch_signals→interpret&#10;uplifts historiques events/promos&#10;→ demand_uplift_pct (7j)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1585" y="335" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ag-decision" value="⑦ DECISION&#10;constraints_check→decide&#10;ORDER/HOLD/MONITOR/EXPEDITE&#10;→ recommendations + PO SUGGERE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1585" y="415" width="220" height="75" as="geometry" />
        </mxCell>
        <mxCell id="inv-par" value="[⑤ Analysis ∥ ⑥ Context] → ⑦ Decision" style="text;html=1;fontSize=10;fontStyle=2;align=center;fillColor=none;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1585" y="498" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="e-inv1" style="endArrow=classic;html=1;strokeColor=#82b366;" edge="1" parent="1" source="ag-analysis" target="ag-decision"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-inv2" style="endArrow=classic;html=1;strokeColor=#82b366;" edge="1" parent="1" source="ag-context" target="ag-decision"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- init -> branches -->
        <mxCell id="ei1" style="endArrow=classic;html=1;strokeColor=#9673a6;strokeWidth=2;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sup-init" target="br-sales"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ei2" style="endArrow=classic;html=1;strokeColor=#9673a6;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sup-init" target="br-know"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ei3" style="endArrow=classic;html=1;strokeColor=#9673a6;strokeWidth=2;exitX=0.6;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sup-init" target="br-ctx"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ei4" style="endArrow=classic;html=1;strokeColor=#9673a6;strokeWidth=2;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sup-init" target="br-inv"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===== MERGE ===== -->
        <mxCell id="sup-merge" value="merge_outputs — FAN-IN : fusion des 4 deltas dans le RetailState partagé (reducers : agents_invoked +, metrics merge, errors +)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="580" width="1260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="em1" style="endArrow=classic;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="br-sales" target="sup-merge"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="em2" style="endArrow=classic;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="br-know" target="sup-merge"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="em3" style="endArrow=classic;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="br-ctx" target="sup-merge"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="em4" style="endArrow=classic;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="br-inv" target="sup-merge"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===== COACH AGENT (cross-domain scoring) ===== -->
        <mxCell id="sup-coach" value="④/⑧ coach_agent — FUSION CROSS-DOMAINE (rank_products)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="670" width="1260" height="180" as="geometry" />
        </mxCell>
        <mxCell id="coach-tools" value="get_sales_context ∥ get_recommendable_products ∥ retrieve_advisor_history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="705" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="coach-formula" value="FORMULE DE SCORE (6 critères) :&#10;0.30·gap_CA + 0.20·stock_health + 0.15·marge&#10;+ 0.15·promo + 0.10·advisor_fit + 0.10·customer_fit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1160" y="705" width="640" height="70" as="geometry" />
        </mxCell>
        <mxCell id="coach-out" value="→ coach_recommendation (product_to_push, product_to_avoid, message, confidence) + scored_products (top-3, avec explicabilité)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="785" width="1220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="emc" style="endArrow=classic;html=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="sup-merge" target="sup-coach"><mxGeometry relative="1" as="geometry" /><mxCell id="emcl" value="lit tout le state" style="edgeLabel;html=1;fontSize=10;" connectable="0" vertex="1" parent="emc"><mxGeometry x="-0.3" relative="1" as="geometry" /></mxCell></mxCell>

        <!-- ===== GUARDRAIL ===== -->
        <mxCell id="sup-guard" value="③ guardrail_agent — 7 RÈGLES (déterministe)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="890" width="1260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="guard-rules" value="G1 stock=0 → BLOCK   ·   G2 rupture &lt;3j → REWRITE   ·   G3 pas de RAG + confiance basse → REWRITE   ·   G4 offre interdite → BLOCK&#10;G5 5G/Fibre sans éligibilité → REWRITE   ·   G6 confiance &lt;0.65 → ESCALATE   ·   G7 commande &gt;100k DT → ESCALATE&#10;&#10;Statut = sévérité MAX des règles violées" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="925" width="1220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="emg" style="endArrow=classic;html=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="sup-coach" target="sup-guard"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===== ROUTING (4 outcomes) ===== -->
        <mxCell id="route-lbl" value="ROUTAGE conditionnel selon le statut du Guardrail" style="text;html=1;fontSize=12;fontStyle=2;align=center;fillColor=none;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="560" y="1055" width="1260" height="20" as="geometry" />
        </mxCell>
        <mxCell id="out-approve" value="APPROVE&#10;notify_frontend&#10;(envoyé tel quel → WS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="565" y="1085" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="out-rewrite" value="REWRITE&#10;retour coach_agent&#10;(max 1 boucle, avec feedback)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="875" y="1085" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="out-escalate" value="ESCALATE&#10;human_validation (HITL)&#10;→ file validation manager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1185" y="1085" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="out-block" value="BLOCK&#10;safe_fallback&#10;(original jamais envoyé)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1495" y="1085" width="280" height="65" as="geometry" />
        </mxCell>

        <mxCell id="er1" style="endArrow=classic;html=1;strokeColor=#b85450;" edge="1" parent="1" source="sup-guard" target="out-approve"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="er2" style="endArrow=classic;html=1;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="sup-guard" target="out-rewrite"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="er3" style="endArrow=classic;html=1;strokeColor=#b85450;" edge="1" parent="1" source="sup-guard" target="out-escalate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="er4" style="endArrow=classic;html=1;strokeColor=#b85450;" edge="1" parent="1" source="sup-guard" target="out-block"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- rewrite loop back to coach -->
        <mxCell id="er-loop" style="endArrow=classic;html=1;strokeColor=#d6b656;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="out-rewrite" target="sup-coach"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1015" y="1170" /><mxPoint x="1900" y="1170" /><mxPoint x="1900" y="760" /></Array></mxGeometry><mxCell id="er-loopl" value="1 boucle max" style="edgeLabel;html=1;fontSize=10;" connectable="0" vertex="1" parent="er-loop"><mxGeometry x="0.5" relative="1" as="geometry" /></mxCell></mxCell>

        <!-- ===== SAVE MEMORY ===== -->
        <mxCell id="sup-mem" value="save_memory → coach_interactions (mémoire → alimente le RAG futur) → END" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="1195" width="1260" height="45" as="geometry" />
        </mxCell>
        <mxCell id="es1" style="endArrow=classic;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="out-approve" target="sup-mem"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="es3" style="endArrow=classic;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="out-escalate" target="sup-mem"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="es4" style="endArrow=classic;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="out-block" target="sup-mem"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- triggers -> supervisor -->
        <mxCell id="et1" style="endArrow=classic;html=1;strokeColor=#d79b00;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.1;" edge="1" parent="1" source="trig-box" target="sup-box"><mxGeometry relative="1" as="geometry" /><mxCell id="et1l" value="ainvoke(RetailState)" style="edgeLabel;html=1;fontSize=10;" connectable="0" vertex="1" parent="et1"><mxGeometry x="-0.2" relative="1" as="geometry" /></mxCell></mxCell>

        <!-- ===================== SHARED STATE (right column) ===================== -->
        <mxCell id="state-box" value="RetailState — TypedDict PARTAGÉ&#10;(le SEUL canal de communication)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="380" width="360" height="470" as="geometry" />
        </mxCell>
        <mxCell id="state-rule" value="RÈGLE D'OR :&#10;chaque node retourne UNIQUEMENT son delta&#10;(jamais **state → InvalidUpdateError)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="95" y="420" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="state-reducers" value="3 canaux à REDUCER (écrits par plusieurs&#10;branches ∥ dans le même superstep) :&#10;• agents_invoked : operator.add&#10;• metrics : merge de dicts&#10;• errors : operator.add" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="95" y="500" width="330" height="105" as="geometry" />
        </mxCell>
        <mxCell id="state-owners" value="Propriétaires de champs (anti-conflit) :&#10;sales_branch → gap, urgency, strategie…&#10;knowledge → retrieved_scripts&#10;context → external_context&#10;inventory → inventory_decisions&#10;coach → coach_recommendation, scored_products&#10;guardrail → guardrail_status/issues/feedback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="95" y="615" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="state-note" value="Aucun agent n'appelle un autre agent&#10;directement — TOUT transite par RetailState." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="95" y="775" width="330" height="60" as="geometry" />
        </mxCell>

        <!-- state connector to merge -->
        <mxCell id="e-state" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#d6b656;strokeWidth=2;dashed=1;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" edge="1" parent="1" source="state-box" target="sup-merge"><mxGeometry relative="1" as="geometry" /><mxCell id="e-statel" value="lecture / écriture" style="edgeLabel;html=1;fontSize=10;" connectable="0" vertex="1" parent="e-state"><mxGeometry x="-0.2" relative="1" as="geometry" /></mxCell></mxCell>

        <!-- ===================== LEGEND ===================== -->
        <mxCell id="legend" value="LÉGENDE&#10;— Violet : SupervisorAgent (méta-graphe)      — Jaune : agents/branches Sales + RetailState&#10;— Vert : agents Inventory        — Bleu : Coach fusion cross-domaine&#10;— Rouge : Guardrail        — Orange : déclencheurs / HITL&#10;— Pointillé : boucle rewrite / accès état&#10;&#10;Numéros ①-⑧ = les 8 agents (cf. ARCHITECTURE_MULTI_AGENT.md)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=10;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="890" width="420" height="200" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
