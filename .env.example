# ==============================================================================
# .env.example -- AI Sales Coach Ooredoo Tunisia
# Multi-provider LLM configuration
# ==============================================================================

# -- Database ----------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ooredoo_sales
DB_USER=postgres
DB_PASSWORD=root


# -- Database (alternative naming - used by main.py) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ooredoo_sales
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
DATABASE_URL=postgresql://postgres:root@localhost:5432/ooredoo_sales

# -- Schemas ------------------------------------------------
DB_SCHEMA_SALES=sales
DB_SCHEMA_INVENTORY=inventory
DB_SCHEMA_MONITORING=monitoring

# -- LLM PRIMARY: OpenRouter (tiered models) ---------------
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-your-openrouter-key
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_MODEL_FAST=nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_MODEL_SMART=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL_GUARDIAN=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL_FALLBACK=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://ooredoo.tn
OPENROUTER_APP_NAME=Ooredoo Retail Coach

# -- LLM SECONDARY: Groq (4-key rotation) -------------------
GROQ_API_KEY_1=gsk_your_first_key
GROQ_API_KEY_2=gsk_your_second_key
GROQ_API_KEY_3=gsk_your_third_key
GROQ_API_KEY_4=gsk_your_fourth_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACK=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# -- LLM TERTIARY: Mistral (independent quota) -------------
MISTRAL_API_KEY=your_mistral_key
MISTRAL_MODEL=mistral-small-latest
MISTRAL_MODEL_FAST=open-mistral-nemo
MISTRAL_MODEL_SMART=mistral-large-latest
MISTRAL_MODEL_GUARDIAN=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# -- LLM FINAL: Ollama (local fallback) --------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_MODEL_ANALYST=llama3.2:latest
OLLAMA_MODEL_STRATEGE=llama3.2:latest
OLLAMA_MODEL_COACH=qwen2.5:0.5b
OLLAMA_EMBED_MODEL=bge-m3

# -- General LLM Settings ----------------------------------
LLM_TEMPERATURE=0.0
# Delai max d'UNE requete vers un provider (secondes). Le budget par SKU de
# l'orchestrator inventory vaut 3x cette valeur (chaine openrouter -> groq ->
# ollama) + 30s : l'augmenter allonge d'autant le temps d'un lot.
LLM_REQUEST_TIMEOUT_S=45

# -- RAG Configuration (Milvus) -----------------------------
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=retail_knowledge
RAG_COLLECTION=retail_knowledge
MILVUS_DIM=768
RAG_EMBED_DIM=1024
RAG_EMBED_MODEL=bge-m3
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.70
RAG_EMBED_TIMEOUT=120

# -- Redis (bus d'alertes + StateBus) -----------------------
# Lu par app/core/config.py::Config.redis_url(), d'où dérivent AlertBus,
# StateBus et AlertCycleTrigger côté sales, et redis_alert_bus côté inventory.
# REDIS_URL, s'il est défini, l'emporte sur les trois variables ci-dessous.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# -- Langfuse (Observability) -------------------------------
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_ENABLED=true

# -- MLflow (Experiment Tracking) ---------------------------
MLFLOW_TRACKING_URI=http://localhost:5000

# -- Business Configuration ----------------------------------
DEFAULT_STORE_ID=I63
DEFAULT_STORE_INTERNAL=OOR_LAC_01
DEFAULT_DAILY_TARGET=1007.0
STORE_OPENING_HOUR=9
STORE_CLOSING_HOUR=20
URGENCY_HIGH_THRESHOLD=0.30
URGENCY_MEDIUM_THRESHOLD=0.15
CYCLE_INTERVAL_MINUTES=15
CYCLE_WARMUP_SECONDS=10
MAX_CONCURRENT_STORES=5
REALTIME_TX_INTERVAL_SECONDS=15

# -- API Configuration ---------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_VERSION=4.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# -- Frontend Configuration ---------------------------------
FRONTEND_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# -- Authentication -----------------------------------------
SECRET_KEY=pfe-ooredoo-secret-key-2026-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# -- Weather API (Context Agent) ----------------------------
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_LATITUDE=36.8065
WEATHER_LONGITUDE=10.1815
WEATHER_TIMEZONE=Africa/Tunis
WEATHER_CACHE_TTL=300

# -- Forecasting Configuration -------------------------------
TIMESFM_MODEL_PATH=./models/timefm
FORECAST_HORIZON_HOURS=8
FORECAST_MAPE_TARGET=0.20

# -- Docker (if services are run via docker-compose) ---------
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=langfuse123
LANGFUSE_DB_NAME=langfuse

# -- Déploiement Docker (voir DOCKER.md) ---------------------
# Ces variables ne servent qu'à `docker compose`. Les hôtes réseau
# (DB_HOST, REDIS_HOST, MILVUS_URI, OLLAMA_BASE_URL...) sont surchargés par
# docker-compose.yml : inutile de toucher aux valeurs ci-dessus, qui restent
# celles d'une exécution directe sur le poste.
#
# Chemin du dépôt frontend Angular, utilisé comme contexte de build.
FRONTEND_PATH=../../frontend/PFE
# 1 = restaure backups/ooredoo_sales_data_*.sql.gz dans une base neuve.
# 0 = base au schéma seul, à peupler via db/seeds/run_all_seeds.py.
AUTO_RESTORE=1
# Boutiques dont le cache inventory est préchauffé au démarrage (~3 min chacune,
# en tâche de fond). Doit couvrir DEFAULT_STORE_ID et la boutique ouverte par
# défaut côté front, sinon la page Stocks affiche 0 à la première ouverture.
INVENTORY_PREWARM_STORES=I63,I14
