# -- Database ----------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ooredoo_sales
DB_USER=postgres
DB_PASSWORD=root
DEFAULT_STORE_ID=I63

# -- Schemas ------------------------------------------------
SCHEMA_SALES=sales
SCHEMA_INVENTORY=inventory
SCHEMA_MONITORING=monitoring

# -- Recommendations: Groq rotation (add your 4 keys here) --
LLM_PROVIDER=groq
GROQ_API_KEY_1=gsk_your_first_key
GROQ_API_KEY_2=gsk_your_second_key
GROQ_API_KEY_3=gsk_your_third_key
GROQ_API_KEY_4=gsk_your_fourth_key
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0

# -- Evaluation: Mistral ------------------------------------
MISTRAL_API_KEY=your_mistral_key
MISTRAL_MODEL_FAST=open-mistral-nemo
MISTRAL_MODEL_SMART=mistral-large-latest
MISTRAL_MODEL_GUARDIAN=mistral-small-latest

# -- Local fallback (already running on your machine) ------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_MODEL_ANALYST=llama3.2:latest
OLLAMA_MODEL_STRATEGE=llama3.2:latest
OLLAMA_MODEL_COACH=qwen2.5:0.5b
OLLAMA_EMBED_MODEL=nomic-embed-text

# -- App ---------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Milvus RAG
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=coaching_scripts
MILVUS_DIM=768

# Langfuse 
LANGFUSE_SECRET_KEY=public_key_here
LANGFUSE_PUBLIC_KEY=secret_key_here
LANGFUSE_HOST="https://cloud.langfuse.com"

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Business config
DEFAULT_STORE_INTERNAL=OOR_LAC_01
DEFAULT_DAILY_TARGET=1007.0
URGENCY_HIGH_THRESHOLD=0.30
URGENCY_MEDIUM_THRESHOLD=0.15
CYCLE_INTERVAL_MINUTES=15
REALTIME_TX_INTERVAL_SECONDS=15