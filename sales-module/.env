# General
SALES_ENV=development
SALES_DEBUG=true
SALES_USE_MOCK_DATA=true

# Ollama
SALES_OLLAMA_BASE_URL=http://localhost:11434
SALES_OLLAMA_MODEL=qwen2.5:0.5b

# TimesFM
SALES_TIMESFM_MODEL_PATH=./models/timesfm
SALES_TIMESFM_HORIZON_HOURS=8
SALES_TIMESFM_CONTEXT_LENGTH=512

# Seuils urgence
SALES_URGENCY_HIGH_THRESHOLD=0.30
SALES_URGENCY_MEDIUM_THRESHOLD=0.15
SALES_DEFAULT_DAILY_TARGET=15000.0

# Redis
SALES_REDIS_URL=redis://localhost:6379
SALES_REDIS_CONTEXT_TTL=300

# BigQuery
SALES_BIGQUERY_PROJECT=ooredoo-retail-dev
SALES_BIGQUERY_DATASET=retail_sales
SALES_BIGQUERY_POS_TABLE=pos_transactions

# LangGraph
SALES_LANGGRAPH_CHECKPOINTER=memory
SALES_MAX_ANALYST_RETRIES=3
# APIs externes (aucune clé requise pour Open-Meteo et Nager.Date)
WEATHER_API=open-meteo
HOLIDAYS_API=nager.date
OOREDOO_SCRAPING=true